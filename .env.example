# Brand Vista POS - Environment Configuration
# Copy this file to .env and fill in your values

# Neon Database Connection String
# Get this from: https://console.neon.tech/app/projects/YOUR_PROJECT_ID
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Server Port
PORT=3000

# Node Environment
NODE_ENV=production

